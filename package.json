	"scripts": {
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"delete-maps": "rm ./build/static/js/*.map && rm ./build/static/css/*.map",
		"format": "prettier --write \"**/*.+(js|jsx|json|yml|yaml|css|md|vue)\""
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest",
			"plugin:prettier/recommended"
		]
	},
	"prettier": {
		"printWidth": 100,
